{
  "name": "@openref/nest",
  "version": "0.0.0",
  "description": "OPENREF for NestJS. Module, decorators and runtime collectors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openref/core": "workspace:*",
    "isomorphic-dompurify": "3.22.0",
    "marked": "18.0.9",
    "minisearch": "7.2.0",
    "shiki": "4.4.2",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@openref/render": "workspace:*",
    "@openref/runner": "workspace:*",
    "@openref/search": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
