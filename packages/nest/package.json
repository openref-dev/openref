{
  "name": "@openref/nest",
  "version": "0.0.0",
  "description": "OPENREF for NestJS. Module, decorators and runtime collectors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openref-dev/openref.git",
    "directory": "packages/nest"
  },
  "homepage": "https://openref.dev",
  "bugs": {
    "url": "https://github.com/openref-dev/openref/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/browser/openref.js",
    "./browser-entry": {
      "source": "./src/browser/compose.ts"
    },
    "./element": "./dist/browser-wc/openref-element.js",
    "./element.iife": "./dist/browser-iife/openref-element.iife.js"
  },
  "files": [
    "dist",
    "DISTRIBUTION.md"
  ],
  "sideEffects": [
    "./src/browser/entry.ts",
    "./src/browser/element-entry.ts",
    "./dist/browser/*",
    "./dist/browser-wc/*",
    "./dist/browser-iife/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@openref/core": "workspace:*",
    "@openref/runner": "workspace:*",
    "@openref/theme": "workspace:*",
    "@openref/vue": "workspace:*",
    "isomorphic-dompurify": "3.22.0",
    "marked": "18.0.9",
    "minisearch": "7.2.0",
    "shiki": "4.4.2",
    "vue": "3.5.41",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@nestjs-redisx/pubsub": "1.12.0",
    "@nestjs-redisx/streams": "1.12.0",
    "@openref/agent": "workspace:*",
    "@openref/federation": "workspace:*",
    "@openref/render": "workspace:*",
    "@openref/samples": "workspace:*",
    "@openref/search": "workspace:*",
    "@openref/static": "workspace:*",
    "jsdom": "30.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
