{
  "name": "@openref/render",
  "version": "0.0.0",
  "description": "OPENREF render pipeline. Internal, bundled into @openref/nest",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "source": "./src/browser/index.ts",
      "import": "./dist/browser/openref.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/browser/entry.ts",
    "./dist/browser/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "private": true,
  "dependencies": {
    "@openref/core": "workspace:*",
    "@openref/vue": "workspace:*",
    "isomorphic-dompurify": "3.22.0",
    "marked": "18.0.9",
    "shiki": "4.4.2",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
