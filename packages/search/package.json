{
  "name": "@openref/search",
  "version": "0.0.0",
  "description": "OPENREF search index builder. Internal, bundled into @openref/nest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openref-dev/openref.git",
    "directory": "packages/search"
  },
  "homepage": "https://openref.dev",
  "bugs": {
    "url": "https://github.com/openref-dev/openref/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "private": true,
  "dependencies": {
    "@openref/core": "workspace:*",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
