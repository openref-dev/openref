{
  "name": "openref",
  "version": "0.0.0",
  "description": "OPENREF command line interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openref-dev/openref.git",
    "directory": "packages/cli"
  },
  "homepage": "https://openref.dev",
  "bugs": {
    "url": "https://github.com/openref-dev/openref/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "bin": {
    "openref": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openref/core": "workspace:*",
    "@openref/nest": "workspace:*",
    "@openref/theme": "workspace:*",
    "@openref/vue": "workspace:*",
    "isomorphic-dompurify": "3.22.0",
    "marked": "18.0.9",
    "minisearch": "7.2.0",
    "shiki": "4.4.2",
    "ts-morph": "28.0.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@openref/render": "workspace:*",
    "@openref/search": "workspace:*",
    "@openref/static": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
