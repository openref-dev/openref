  "nodes": [
    [
      "channel-smartylighting-streetlights-1-0-action-streetlightid-dim",
      {
        "address": "smartylighting/streetlights/1/0/action/{streetlightId}/dim",
        "deprecated": false,
        "id": "channel-smartylighting-streetlights-1-0-action-streetlightid-dim",
        "kind": "channel",
        "messages": [
          {
            "contentType": "application/json",
            "headers": {
              "kind": "inline",
              "schema": {
                "dialect": "asyncapi-schema",
                "id": "channel-smartylighting-streetlights-1-0-action-streetlightid-dim.messages.dimLight.headers",
                "normalized": {
                  "properties": {
                    "my-app-header": {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "id": "dimLight",
            "name": "dimLight",
            "payload": {
              "kind": "named",
              "schemaId": "dimLightPayload"
            },
            "summary": "Command a particular streetlight to dim the lights.",
            "title": "Dim light"
          }
        ],
        "operations": [
          {
            "bindings": {
              "mqtt": {
                "qos": 1
              }
            },
            "direction": "send",
            "id": "dimLight",
            "messageIds": [
              "dimLight"
            ]
          }
        ],
        "parameters": {
          "streetlightId": {
            "description": "The ID of the streetlight."
          }
        },
        "protocol": "mqtt",
        "servers": [
          {
            "description": "Test broker",
            "url": "mqtt://test.mosquitto.org:{port}"
          }
        ],
        "tags": []
      }
    ],
