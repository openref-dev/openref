  "nodes": [
    [
      "channel-queue",
      {
        "address": "{queue}",
        "bindings": {
          "amqp": {
            "is": "queue",
            "queue": {
              "exclusive": true
            }
          }
        },
        "deprecated": false,
        "id": "channel-queue",
        "kind": "channel",
        "messages": [
          {
            "contentType": "application/json",
            "correlationId": "$message.header#/correlation_id",
            "id": "receiveSumResult",
            "payload": {
              "kind": "inline",
              "schema": {
                "dialect": "asyncapi-schema",
                "id": "channel-queue.messages.receiveSumResult.payload",
                "normalized": {
                  "properties": {
                    "result": {
                      "examples": [
                        7
                      ],
                      "type": "number"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        ],
        "operations": [
          {
            "bindings": {
              "amqp": {
                "ack": false
              }
            },
            "direction": "receive",
            "id": "receiveSumResult",
            "messageIds": [
              "receiveSumResult"
            ]
          }
        ],
        "parameters": {
          "queue": {}
        },
        "protocol": "amqp",
        "servers": [
          {
            "url": "amqp://rabbitmq.example.org"
          }
        ],
        "tags": []
      }
    ],
    [
      "channel-rpc-queue",
      {
        "address": "rpc_queue",
        "bindings": {
          "amqp": {
            "is": "queue",
            "queue": {
              "durable": false
            }
          }
        },
        "deprecated": false,
        "id": "channel-rpc-queue",
        "kind": "channel",
        "messages": [
          {
            "contentType": "application/json",
            "correlationId": "$message.header#/correlation_id",
            "id": "requestSum",
            "payload": {
              "kind": "inline",
              "schema": {
                "dialect": "asyncapi-schema",
                "id": "channel-rpc-queue.messages.requestSum.payload",
                "normalized": {
                  "properties": {
                    "numbers": {
                      "examples": [
                        [
                          4,
                          3
                        ]
                      ],
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        ],
        "operations": [
          {
            "bindings": {
              "amqp": {
                "ack": true
              }
            },
            "direction": "send",
            "id": "requestSum",
            "messageIds": [
              "requestSum"
            ]
          }
        ],
        "protocol": "amqp",
        "servers": [
          {
            "url": "amqp://rabbitmq.example.org"
          }
        ],
        "tags": []
      }
    ]
  ],
