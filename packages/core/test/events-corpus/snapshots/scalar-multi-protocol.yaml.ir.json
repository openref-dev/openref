      "DeviceTelemetryPayload",
      {
        "dialect": "asyncapi-schema",
        "id": "DeviceTelemetryPayload",
        "name": "DeviceTelemetryPayload",
        "normalized": {
          "properties": {
            "battery": {
              "examples": [
                87
              ],
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "deviceId": {
              "examples": [
                "sensor-7"
              ],
              "type": "string"
            },
            "temperature": {
              "examples": [
                21.4
              ],
              "type": "number"
            }
          },
          "required": [
            "deviceId",
            "temperature"
          ],
          "type": "object"
        }
      }
    ],
    [
      "InventoryChangedPayload",
      {
        "dialect": "asyncapi-schema",
