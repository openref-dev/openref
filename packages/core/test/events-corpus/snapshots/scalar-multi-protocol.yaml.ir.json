        "normalized": {
          "properties": {
            "available": {
              "examples": [
                42
              ],
              "type": "integer"
            },
            "sku": {
              "examples": [
                "hoodie-black-m"
              ],
              "type": "string"
            },
            "warehouse": {
              "examples": [
                "vancouver"
              ],
              "type": "string"
            }
          },
          "required": [
