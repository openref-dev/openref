              "storjusd",
              "snxusd",
              "crvusd",
              "balusd",
              "uniusd",
              "renusd",
              "umausd",
              "yfiusd",
              "btcdai",
              "ethdai",
              "aaveusd",
              "filusd",
              "btceur",
              "btcgbp",
              "etheur",
              "ethgbp",
              "btcsgd",
              "ethsgd",
