        "normalized": {
          "properties": {
            "apis": {
              "items": {
                "properties": {
                  "apiDocumentationUrl": {
                    "description": "A URL to the API console for each API",
                    "format": "uriref",
                    "type": "string"
                  },
                  "apiKey": {
                    "description": "To be used as a dataset parameter value",
                    "type": "string"
                  },
                  "apiUrl": {
                    "description": "The URL describing the dataset's fields",
                    "format": "uriref",
                    "type": "string"
                  },
                  "apiVersionNumber": {
                    "description": "To be used as a version parameter value",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "total": {
              "type": "integer"
            }
          },
          "type": "object"
        }
      }
    ]
  ],
  "security": [],
  "servers": [
    {
