      "query-flights-search",
      {
        "deprecated": false,
        "description": "Uses the HTTP QUERY method to perform a safe, idempotent flight search with filters that are too complex for a URL query string.\n",
        "id": "query-flights-search",
        "kind": "operation",
        "method": "query",
        "operationId": "searchFlights",
        "parameters": [],
        "path": "/flights/search",
        "rawOperationId": "searchFlights",
        "requestBody": {
          "content": [
            {
              "mediaType": "application/json",
              "schema": {
                "kind": "inline",
                "schema": {
                  "dialect": "json-schema-2020-12",
                  "id": "query-flights-search.requestBody.application/json",
                  "normalized": {
                    "properties": {
                      "origin": {
                        "examples": [
                          "ATL"
                        ],
                        "type": "string"
                      },
                      "destination": {
                        "examples": [
                          "LHR"
                        ],
                        "type": "string"
                      },
                      "departureDate": {
                        "examples": [
                          "2026-06-15"
                        ],
                        "format": "date",
                        "type": "string"
                      },
                      "returnDate": {
                        "examples": [
                          "2026-06-25"
                        ],
                        "format": "date",
                        "type": "string"
                      },
                      "passengers": {
                        "examples": [
                          2
                        ],
                        "minimum": 1,
                        "type": "integer"
                      },
                      "cabinClass": {
                        "enum": [
                          "economy",
                          "premium-economy",
                          "business",
                          "first"
                        ],
                        "examples": [
                          "business"
                        ],
                        "type": "string"
                      },
                      "nonStopOnly": {
                        "examples": [
                          true
                        ],
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "origin",
                      "destination",
                      "departureDate"
                    ],
                    "type": "object"
                  }
                }
              }
            }
          ],
          "required": true
        },
        "responses": [
          {
            "content": [
              {
                "mediaType": "application/json",
                "schema": {
                  "kind": "inline",
                  "schema": {
                    "dialect": "json-schema-2020-12",
                    "id": "query-flights-search.responses.200.application/json",
                    "normalized": {
                      "properties": {
                        "flights": {
                          "items": {
                            "properties": {
                              "flightNumber": {
                                "examples": [
                                  "DL30"
                                ],
                                "type": "string"
                              },
                              "origin": {
                                "examples": [
                                  "ATL"
                                ],
                                "type": "string"
                              },
                              "destination": {
                                "examples": [
                                  "LHR"
                                ],
                                "type": "string"
                              },
                              "departureTime": {
                                "examples": [
                                  "2026-06-15T22:30:00Z"
                                ],
                                "format": "date-time",
                                "type": "string"
                              },
                              "arrivalTime": {
                                "examples": [
                                  "2026-06-16T10:15:00Z"
                                ],
                                "format": "date-time",
                                "type": "string"
                              },
                              "price": {
                                "examples": [
                                  1249.99
                                ],
                                "format": "float",
                                "type": "number"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  }
                }
              }
            ],
            "description": "Matching flights",
            "statusCode": "200"
